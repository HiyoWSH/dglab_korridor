{
  // 联动服务自身的 HTTP 监听地址（游戏插件把状态推送到这里）
  "listen": {
    "host": "127.0.0.1",       // 只在本机监听；改为 0.0.0.0 可让局域网其它机器推送
    "port": 9996,              // 插件 cfg 里的 ApiUrl 必须指向这个端口
    "token": ""                // 非空时推送需带 X-API-Key 头，需与插件 cfg 的 ApiKey 一致
  },

  // 上游 control-service 的 HTTP 地址（联动服务通过它下发震动）
  "control": {
    "baseUrl": "http://127.0.0.1:9997",
    "token": ""                // control 若设了 api.token，这里要填相同值
  },

  // 血量阈值兼容兜底（百分比）：现以 modes.mode1/2/3 的 hpBelow 为准，此处仅当 hpBelow 缺失时生效
  "thresholds": {
    "low80": 80,
    "low50": 50,
    "low20": 20
  },

  // 迟滞：血量回升超过阈值 + 该值才会重新布防，防止阈值附近抖动连发
  "hysteresisPercent": 3,

  // 轻伤/中伤/死亡共享的冷却（毫秒）；掉进更严重档位可无视冷却立即触发
  "cooldownMs": 5000,

  // 输出预算：每个通道同时活跃震动的输出档位之和上限（设备公式：振幅×强度/1000）
  "output": {
    "maxPerChannel": 20
  },

  // 围攻压力：当前彻底关闭（enabled=false 时下面阈值不生效）
  "siege": {
    "enabled": false,          // 改为 true 重新开启
    "minEnemies": 120          // 敌人数 ≥ 此值时循环触发（仅在 enabled=true 时生效）
  },

  /*
    各模式参数：
    strength  全局强度（0-200，原样下发）
    durationMs 单次时长；periodMs 仅循环型模式（mode3/siege）的节拍间隔
    frames    波形帧数组，每帧 8 字节 / 16 位 hex：前 4 字节=频率，后 4 字节=振幅(00-64)
              一帧 = 4 个时间片 × 25ms = 100ms；帧数 ≈ 时长/100ms，整段正好播一遍不循环
              输出档位 ≈ floor(振幅 × 强度 / 1000)，故各模式峰值振幅保留 64 以维持 output 档位
              频率段统一 64646464（保持已调好的中等脉冲基调）；强弱停节奏全靠振幅段排列
              振幅速查：64=满幅  50=78%  32=50%  19=25%  00=停
              循环型模式(mode3/siege)帧数按 periodMs/100 对齐，避免整段节奏被下一拍截断
    channel   0=A 通道, 1=B 通道, 2=A+B 双通道
    output    该模式占用的输出档位（用于预算与驱逐计算）
    priority  优先级，越大越高；高优先级可驱逐低优先级
    hpBelow   仅血量模式(mode1/2/3)：血量低于该百分比触发该档，需满足 濒死 < 中伤 < 轻伤
  */
  "modes": {
    "mode1": {                 // 轻伤：血量下降穿越 90%（6 帧 / 600ms，轻叩三连 + 渐弱）
      "hpBelow": 90,           // 血量低于 90% 触发轻伤
      "strength": 20,
      "durationMs": 600,
      "frames": [
        "6464646464646464",    // 满幅轻叩（2 档）
        "6464646400000000",    // 停
        "6464646464646464",    // 再叩
        "6464646400000000",    // 停
        "6464646450505050",    // 渐弱（1 档）
        "6464646432320000"     // 收尾（1 档 → 停）
      ],
      "channel": 0,
      "output": 2,
      "priority": 70
    },
    "mode2": {                 // 中伤：血量下降穿越 60%（12 帧 / 1200ms，强-强-停脉冲群 ×3）
      "hpBelow": 60,           // 血量低于 60% 触发中伤
      "strength": 60,
      "durationMs": 1200,
      "frames": [
        "6464646450505050",    // 起势 3 档
        "6464646464646464",    // 满幅 6 档
        "6464646464646464",
        "6464646400000000",    // 停
        "6464646450505050",
        "6464646464646464",
        "6464646464646464",
        "6464646400000000",
        "6464646450505050",
        "6464646464646464",
        "6464646464646464",
        "6464646400000000"
      ],
      "channel": 0,
      "output": 6,
      "priority": 80
    },
    "mode3": {                 // 濒死：血量 <35% 持续循环（8 帧 / 800ms=一拍，强弱细颤 + 骤停抽搐）
      "hpBelow": 35,           // 血量低于 35% 进入濒死循环
      "strength": 120,
      "durationMs": 1000,
      "periodMs": 800,
      "frames": [
        "6464646464326432",    // 帧内细颤 12↔6 档
        "6464646464646464",    // 峰值 12 档
        "6464646464326432",
        "6464646432323232",    // 落 6 档
        "6464646464326432",
        "6464646464646464",
        "6464646464326432",
        "6464646432320000"     // 抽搐收尾
      ],
      "channel": 0,
      "output": 12,
      "priority": 60
    },
    "mode4": {                 // 死亡：活→死瞬间一次性触发（30 帧 / 3000ms，全程满幅爆发 + 心跳重拍，无停顿/无渐弱），独占屏蔽其它模式
      "strength": 200,
      "durationMs": 3000,
      "frames": [
        "6464646464646464",    // 爆发建立：5 帧满幅 20 档
        "6464646464646464",
        "6464646464646464",
        "6464646464646464",
        "6464646464646464",
        "6464646450505050",    // 心跳重拍 15 档
        "6464646464646464",    // 满幅 20 档
        "6464646450505050",
        "6464646464646464",
        "6464646450505050",
        "6464646464646464",
        "6464646450505050",
        "6464646464646464",
        "6464646450505050",
        "6464646464646464",
        "6464646450505050",
        "6464646464646464",
        "6464646450505050",
        "6464646464646464",
        "6464646450505050",
        "6464646464646464",
        "6464646450505050",
        "6464646464646464",
        "6464646450505050",
        "6464646464646464",    // 末尾维持满幅收尾，不渐弱、不停顿
        "6464646464646464",
        "6464646464646464",
        "6464646464646464",
        "6464646464646464",
        "6464646464646464"
      ],
      "channel": 0,
      "output": 20,
      "priority": 100
    },
    "marks": {                 // Marks 获得（4 帧 / 400ms，两下轻提示递减），B 通道
      "strength": 30,
      "durationMs": 400,
      "frames": [
        "6464646464646464",    // 3 档
        "6464646400000000",
        "6464646432323232",    // 1 档
        "6464646400000000"
      ],
      "channel": 1,
      "output": 3,
      "priority": 15
    },
    "bossAppear": {            // Boss 登场（15 帧 / 1500ms，阶梯渐强 + 心跳脉冲），A+B
      "strength": 80,
      "durationMs": 1500,
      "frames": [
        "6464646432323232",    // 2 档 起
        "6464646432323232",
        "6464646450505050",    // 4 档
        "6464646450505050",
        "6464646464646464",    // 8 档 满
        "6464646464646464",
        "6464646450505050",    // 心跳：4↔8 档交替
        "6464646464646464",
        "6464646450505050",
        "6464646464646464",
        "6464646450505050",
        "6464646464646464",
        "6464646450505050",
        "6464646464646464",
        "6464646464646464"
      ],
      "channel": 2,
      "output": 8,
      "priority": 45
    },
    "bossKill": {              // Boss 击杀（15 帧 / 1500ms，强弱大脉冲 + 结尾四连重击），A+B
      "strength": 150,
      "durationMs": 1500,
      "frames": [
        "6464646464646464",    // 15 档
        "6464646400000000",
        "6464646464646464",
        "6464646432323232",    // 7 档
        "6464646464646464",
        "6464646400000000",
        "6464646464646464",
        "6464646432323232",
        "6464646464646464",
        "6464646400000000",
        "6464646464646464",
        "6464646464646464",    // 四连重击
        "6464646464646464",
        "6464646464646464",
        "6464646464646464"
      ],
      "channel": 2,
      "output": 15,
      "priority": 50
    },
    "bossPhase2": {            // Boss 二阶段（10 帧 / 1000ms，阶梯骤升 + 持续满幅），A 通道
      "strength": 100,
      "durationMs": 1000,
      "frames": [
        "6464646432323232",    // 3 档
        "6464646450505050",    // 5 档
        "6464646464646464",    // 10 档 满
        "6464646450505050",
        "6464646464646464",
        "6464646450505050",
        "6464646464646464",
        "6464646464646464",
        "6464646464646464",
        "6464646464646464"
      ],
      "channel": 0,
      "output": 10,
      "priority": 40
    },
    "siege": {                 // 围攻压力（已在上面 enabled=false 关闭，此配置暂不生效；10 帧 / 1000ms=一拍强弱颤动）
      "strength": 50,
      "durationMs": 1000,
      "periodMs": 1000,
      "frames": [
        "6464646464646464",    // 5 档
        "6464646432323232",    // 2 档
        "6464646464646464",
        "6464646432323232",
        "6464646464646464",
        "6464646432323232",
        "6464646464646464",
        "6464646432323232",
        "6464646464646464",
        "6464646432323232"
      ],
      "channel": 0,
      "output": 5,
      "priority": 35
    },
    "kill": {                  // 击杀连段（2 帧 / 200ms，一下即停的短促点击），B 通道
      "strength": 40,
      "durationMs": 200,
      "frames": [
        "6464646464646464",    // 4 档
        "6464646400000000"
      ],
      "channel": 1,
      "output": 4,
      "priority": 25
    }
  }
}
